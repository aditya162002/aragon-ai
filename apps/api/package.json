{
  "name": "@aragon/api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API + background worker that stores, validates and classifies uploaded selfies.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aragon/shared": "*",
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "heic-decode": "2.1.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "onnxruntime-node": "1.30.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
