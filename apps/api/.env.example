# Copy to apps/api/.env — defaults match docker-compose.yml for local development.
NODE_ENV=development
PORT=4000
# Origin of the web app (used for CORS when the web app is not served through the Vite proxy).
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://aragon:aragon@localhost:5433/aragon

# Signs the anonymous-session cookie. Use a long random value outside local dev: `openssl rand -hex 32`
SESSION_SECRET=local-dev-only-secret-change-me-0123456789abcdef

# Any S3-compatible store. For AWS S3: remove S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false and real credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aragon-photos
S3_ACCESS_KEY_ID=aragon-dev
S3_SECRET_ACCESS_KEY=aragon-dev-secret
S3_FORCE_PATH_STYLE=true
# Creates the bucket on startup (local dev convenience; keep false in production).
S3_AUTO_CREATE_BUCKET=true

# Where `npm run models:fetch` stores the face-detection model.
MODELS_DIR=./models
